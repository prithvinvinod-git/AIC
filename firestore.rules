rules_version = '2';

// Second wall behind Next.js route handlers. Route handlers are the source of
// truth (RBAC + state machine in src/lib/issueMachine.ts); these rules stop a
// malicious client from bypassing the app and writing `status` directly.

service cloud.firestore {
  match /databases/{database}/documents {

    match /issues/{id} {
      allow create: if request.auth != null
                    && request.auth.token.role == 'reporter'
                    && request.resource.data.status == 'NEW';
      allow update: if request.auth != null && (
                    (request.auth.token.role == 'validator'    && resource.data.status in ['NEW', 'VALIDATED', 'APPROVED', 'PENDING', 'ASSIGNED', 'ONGOING'])
                 || (request.auth.token.role == 'hod'          && resource.data.status == 'ESCALATED')
                 || (request.auth.token.role == 'principal'    && resource.data.status == 'ESCALATED')
                 || (request.auth.token.role == 'maintenance_head' && resource.data.status in ['ROUTED', 'PENDING_ASSIGN'])
                 || (request.auth.token.role == 'category_head'   && resource.data.status in ['PENDING_ASSIGN', 'COMPLETED'])
                 || (request.auth.token.role == 'maintenance'  && resource.data.status in ['ASSIGNED', 'ONGOING'])
                 || (request.auth.token.role == 'admin'));
      allow read: if request.auth != null;
    }

    match /issues/{id}/timeline/{entryId} {
      allow read, create: if request.auth != null;
    }

    match /issues/{id}/comments/{commentId} {
      allow read, create: if request.auth != null;
    }

    match /issues/{id}/attachments/{attId} {
      allow read, create: if request.auth != null;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /categories/{catId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /notifications/{uid}/items/{docId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
    }

    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'principal', 'hod'];
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /stats/{doc} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'validator', 'hod', 'principal'];
      allow write: if false;
    }
  }
}

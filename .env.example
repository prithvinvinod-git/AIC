# Copy this file to `.env.local` and fill in real values.
# NEVER commit real keys — `.env.local` is gitignored.
# Placeholders only live here; the app falls back to keyword-based AI and
# disables email when the relevant keys are absent.

# Firebase web config — paste from Firebase Console → Project settings →
# General → Your apps, then fill the fields below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FCM push notifications — from Firebase Console → Project settings →
# Cloud Messaging → Web Push certificates → Key pair (Generate).
# Empty = push notifications disabled.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Admin SDK (server-side) — service account from Firebase Console →
# Project settings → Service accounts → "Generate new private key".
# FIREBASE_PRIVATE_KEY keeps its \n escapes; the app expands them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google AI key — enables real Genkit/Gemini flows. When absent, a
# keyword-based fallback classifier powers all AI features.
GOOGLE_GENAI_API_KEY=
GENKIT_ENV=dev

# Optional fast lane: Groq free tier (console.groq.com, no credit card).
# When set, triage tries Gemini first, then Groq Llama 3.3 70B.
# AI_MODEL= overrides the Gemini model used by the other AI flows.
# Default AI_MODEL is gemini-3.1-flash-lite (the free-tier model a new key
# can actually call — 2.5-flash is no longer available to new users).
GROQ_API_KEY=
AI_MODEL=

# Email (optional, best-effort). EMAIL_ENABLED=true turns it on.
# EMAIL_FROM must equal the SMTP_USER account for Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_ENABLED=
EMAIL_FROM=
EMAIL_FROM_NAME=
# When set, ALL mail goes to this one inbox (test override).
EMAIL_TEST_RECIPIENT=

# Canonical app URL used in email link CTAs + sitemap.
APP_URL=

# Shared secret guarding the Vercel cron endpoints
# (/api/cron/sla-reminders, /api/cron/auto-close, /api/cron/escalate-stale).
CRON_SECRET=